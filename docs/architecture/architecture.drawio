<mxfile host="app.diagrams.net" type="device"><diagram id="architecture" name="Architecture"><mxGraphModel dx="2240" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2240" pageHeight="1000" background="none" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="&lt;b style=&quot;font-size:18px&quot;&gt;Udyam Digital — solution architecture (prototype)&lt;/b&gt;&lt;br&gt;Journey: advisor → quote with time to value → KYC (lookup first → consent → documents → readiness) → MOCK e-sign → MOCK payment → tracker · same journey on WhatsApp · back-office for exceptions" style="text;html=1;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="2100" height="50" as="geometry" /></mxCell><mxCell id="owner" value="&lt;b&gt;Small-business owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;phone browser, English / हिंदी&lt;br&gt;self-serve, in one sitting&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="140" width="185" height="76" as="geometry" /></mxCell><mxCell id="partner" value="&lt;b&gt;Partner / field sales&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;shares a referral link / QR&lt;br&gt;/?ref=PTR-01&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="280" width="185" height="66" as="geometry" /></mxCell><mxCell id="staff" value="&lt;b&gt;Staff&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MOCK sign-in, 3 roles:&lt;br&gt;operations desk (KYC review),&lt;br&gt;field sales, channel partners&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="185" height="80" as="geometry" /></mxCell><mxCell id="speech" value="&lt;b&gt;Browser speech service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Web Speech API&lt;br&gt;Chrome → Google&lt;br&gt;Edge → Microsoft&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="588" width="185" height="84" as="geometry" /></mxCell><mxCell id="fe" value="Frontend · React 19 + Vite 7 + TS · :5173" style="swimlane;rounded=1;arcSize=4;whiteSpace=wrap;html=1;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="70" width="330" height="690" as="geometry" /></mxCell><mxCell id="app" value="&lt;b&gt;Owner app (mobile-first, EN / HI)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Home · Advisor chat (GenAI)&lt;br&gt;Quote: price, setup, contract, value timeline&lt;br&gt;KYC: lookup → consent → name → documents&lt;br&gt;&amp;nbsp;&amp;nbsp;One-Sitting readiness card, a fix per blocker&lt;br&gt;MOCK e-sign · MOCK payment · Tracker&lt;br&gt;My data · Continue my application&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="110" width="300" height="150" as="geometry" /></mxCell><mxCell id="vite" value="&lt;b&gt;Shared in the app&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;i18n English / हिंदी (key-parity tested)&lt;br&gt;identifiers only ever shown masked&lt;br&gt;referral ?ref= code kept with the journey&lt;br&gt;dev server proxies /api/* to the backend&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="275" width="300" height="90" as="geometry" /></mxCell><mxCell id="wasim" value="&lt;b&gt;WhatsApp simulator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;plays the owner&amp;#x27;s WhatsApp: buttons, lists,&lt;br&gt;photos, voice notes · labelled MOCK&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="380" width="300" height="80" as="geometry" /></mxCell><mxCell id="bo" value="&lt;b&gt;Staff back-office  /backoffice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Advisor leads + propensity score · Past&lt;br&gt;quarter (CRM) · KYC exceptions + photos ·&lt;br&gt;Partner credit · One-sitting metrics ·&lt;br&gt;retention job (DEMO date)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="470" width="300" height="100" as="geometry" /></mxCell><mxCell id="voice" value="&lt;b&gt;Voice dictation 🎤 + read-aloud 🔊&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;words appear in the box; owner edits, then Send&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="600" width="300" height="60" as="geometry" /></mxCell><mxCell id="be" value="Backend API · Node 22 + Express 5 + TS · :4000 — every decision is made here" style="swimlane;rounded=1;arcSize=4;whiteSpace=wrap;html=1;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="740" y="70" width="650" height="690" as="geometry" /></mxCell><mxCell id="advisor" value="&lt;b&gt;Advisor engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;7 questions · EN / HI / Hinglish parser&lt;br&gt;LLM only words it: guard on every sentence&lt;br&gt;basic mode without a key · leads not closed&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="110" width="300" height="80" as="geometry" /></mxCell><mxCell id="rules" value="&lt;b&gt;Catalogue rules engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;5 eligibility rules (tier, people, sites,&lt;br&gt;active GSTIN, requires_one_of) · pricing ·&lt;br&gt;5 segment bundle templates&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="200" width="300" height="80" as="geometry" /></mxCell><mxCell id="quote" value="&lt;b&gt;Quote engine + computeTimeline&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;one monthly price, setup, contract (and its&lt;br&gt;driver), ready dates, Day-1 products, add-ons&lt;br&gt;re-checked by the rules on every toggle&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="290" width="300" height="80" as="geometry" /></mxCell><mxCell id="wabot" value="&lt;b&gt;WhatsApp bot · MOCK Business API webhook&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;/api/channels/whatsapp · one chat per number&lt;br&gt;the whole journey, reusing the same modules&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="380" width="300" height="80" as="geometry" /></mxCell><mxCell id="boapi" value="&lt;b&gt;Back-office API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;MOCK staff sign-in, roles admin / sales /&lt;br&gt;partner · referral attribution · CRM leads ·&lt;br&gt;KYC review (approve / reject) · metrics ·&lt;br&gt;retention trigger&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="470" width="300" height="100" as="geometry" /></mxCell><mxCell id="logger" value="&lt;b&gt;Masking JSON logger&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;no identifier, document or OCR text in logs&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="580" width="300" height="60" as="geometry" /></mxCell><mxCell id="kyc" value="&lt;b&gt;Smart KYC&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GSTIN mod-36 checksum (X allowed), Udyam&lt;br&gt;(district 00 ok), O/0 I/1 fixes · checks for&lt;br&gt;K01–K12 · Pass / Fix needed / Manual review&lt;br&gt;· &amp;#x27;Did you mean …?&amp;#x27; · reviewer decision&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1075" y="110" width="300" height="100" as="geometry" /></mxCell><mxCell id="ready" value="&lt;b&gt;One-Sitting Completion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;readiness state + %, blockers with a fix,&lt;br&gt;alternative bundles (via the rules engine),&lt;br&gt;partner assistance · save and return&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1075" y="220" width="300" height="80" as="geometry" /></mxCell><mxCell id="privacy" value="&lt;b&gt;Privacy (DPDP)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;consent record, KYC writes refused without&lt;br&gt;it (403) · lookup first · one masking utility&lt;br&gt;· AES-256-GCM photo vault · retention job&lt;br&gt;every 6 h · My data, withdraw, delete&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1075" y="310" width="300" height="100" as="geometry" /></mxCell><mxCell id="orders" value="&lt;b&gt;Orders + tracker&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;checkout (setup + 1st month) · order ·&lt;br&gt;stages, planned vs actual per product ·&lt;br&gt;stopped if consent is withdrawn&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1075" y="420" width="300" height="80" as="geometry" /></mxCell><mxCell id="mocks" value="&lt;b&gt;MOCK services (labelled)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;GST / Udyam registry lookups (CSV) · OTP&lt;br&gt;e-sign · payment · owner signing link · coverage&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;dashed=1;shadow=0;" vertex="1" parent="1"><mxGeometry x="1075" y="510" width="300" height="70" as="geometry" /></mxCell><mxCell id="propc" value="&lt;b&gt;Propensity client&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;back-office lists still work if it is down&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1075" y="590" width="300" height="50" as="geometry" /></mxCell><mxCell id="stores" value="&lt;b&gt;In-memory stores (prototype: cleared on restart)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;accepted quotes · advisor chats + leads · KYC cases (consent record, blockers, deletion log) ·&lt;br&gt;orders · staff sessions (8 h) · WhatsApp chats (24 h)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="755" y="675" width="620" height="70" as="geometry" /></mxCell><mxCell id="ai" value="AI service · Python 3.13 + FastAPI · :8000" style="swimlane;rounded=1;arcSize=4;whiteSpace=wrap;html=1;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1530" y="70" width="340" height="430" as="geometry" /></mxCell><mxCell id="aiadv" value="&lt;b&gt;/advisor/understand · /advisor/explain&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Gemini via google-genai, JSON-schema output&lt;br&gt;identifiers masked before sending&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1545" y="110" width="310" height="80" as="geometry" /></mxCell><mxCell id="ocr" value="&lt;b&gt;/kyc/read · OCR&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;RapidOCR (ONNX, offline) · pink watermark&lt;br&gt;removed · tilted pages straightened ·&lt;br&gt;fields by page layout · image never kept&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1545" y="200" width="310" height="90" as="geometry" /></mxCell><mxCell id="prop" value="&lt;b&gt;/propensity/score · /leads · /model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;loads models/propensity.json (coefficients)&lt;br&gt;score 0–100, band, top 3 reasons&lt;br&gt;no leakage columns · test AUC 0.670&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1545" y="300" width="310" height="90" as="geometry" /></mxCell><mxCell id="train" value="&lt;b&gt;Offline training&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;python -m app.propensity.train&lt;br&gt;scikit-learn, stratified split, 5-fold CV&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1545" y="400" width="310" height="80" as="geometry" /></mxCell><mxCell id="ext" value="External" style="swimlane;rounded=1;arcSize=4;whiteSpace=wrap;html=1;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="1920" y="70" width="290" height="300" as="geometry" /></mxCell><mxCell id="gemini" value="&lt;b&gt;Google Gemini API (optional)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;gemini-3.5-flash-lite&lt;br&gt;key only in .env, used by the ai-service&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1935" y="110" width="260" height="80" as="geometry" /></mxCell><mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;→&amp;nbsp;&amp;nbsp;request / data flow&lt;br&gt;- - -&amp;nbsp;&amp;nbsp;dashed box: MOCK, a working&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;stand-in, labelled in the UI&lt;br&gt;Green: decides · Purple: AI helps&lt;br&gt;Masked IDs everywhere:&lt;br&gt;GSTIN 27XU********1ZP&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1935" y="210" width="260" height="145" as="geometry" /></mxCell><mxCell id="why" value="&lt;b&gt;Design rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;Rules engine decides eligibility and&lt;br&gt;price; the LLM only explains.&lt;br&gt;Today = 2026-07-15, injected.&lt;br&gt;Every mock works without keys;&lt;br&gt;no LLM key → basic mode.&lt;/font&gt;" style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="1935" y="380" width="260" height="120" as="geometry" /></mxCell><mxCell id="data" value="Data &amp; files" style="swimlane;rounded=1;arcSize=4;whiteSpace=wrap;html=1;startSize=30;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=none;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="290" y="800" width="1580" height="160" as="geometry" /></mxCell><mxCell id="raw" value="&lt;b&gt;data/raw (read-only, treated as customer data)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;product_catalogue.csv (25 products) · smb_leads.csv (5,000 leads)&lt;br&gt;mock_gstin_registry.csv · mock_udyam_registry.csv&lt;br&gt;kyc_documents/ (K01–K12 sample images, DEMO)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="305" y="840" width="520" height="100" as="geometry" /></mxCell><mxCell id="vault" value="&lt;b&gt;backend/var/documents&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;KYC photos, AES-256-GCM encrypted&lt;br&gt;random file names, git-ignored&lt;br&gt;deleted 30 days after verification,&lt;br&gt;or at once on request / withdrawal&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=2;shadow=0;" vertex="1" parent="1"><mxGeometry x="845" y="840" width="320" height="100" as="geometry" /></mxCell><mxCell id="env" value="&lt;b&g