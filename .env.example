# Copy this file to .env in the repo root:  Copy-Item .env.example .env
# Never commit .env. Every service reads the root .env; all values below are safe defaults,
# so the app also runs without a .env file.

# Backend (Node + Express): the single API the frontend calls
BACKEND_PORT=4000

# AI service (Python + FastAPI): called only by the backend
AI_SERVICE_PORT=8000
AI_SERVICE_URL=http://127.0.0.1:8000

# Frontend dev server (Vite). It forwards /api/* to the backend on BACKEND_PORT.
FRONTEND_PORT=5173

# Log level for backend and ai-service: debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------- Advisor AI helper (Gemini)
# Optional. Without a key the advisor works in "basic mode" (its own rules and sentences).
# Get a free key at https://aistudio.google.com -> "Get API key" -> "Create API key", then put it
# in YOUR .env (never in this file, never in code, never in chat). Only the ai-service reads it.
# Restart the ai-service after changing any of these.
GEMINI_API_KEY=
# Fast model with a free quota (checked on 2026-11-08). gemini-3.8-flash also works but answered
# in 25-45 s on the free plan, too slow for a chat.
GEMINI_MODEL=gemini-3.5-flash-lite
# Seconds to wait for Gemini before the advisor answers by its rules (1-60).
GEMINI_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------- KYC document storage (privacy)
# Uploaded document photos are encrypted at rest (AES-256-GCM) with this key: 32 bytes as 64 hex
# characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Without it the backend makes a random key at start-up (photos then cannot be read after a
# restart, like everything else the prototype keeps in memory).
DOCUMENT_ENCRYPTION_KEY=
# Folder for the encrypted photos (outside any public folder; git-ignored). Default: backend/var/documents
DOCUMENT_STORE_DIR=
